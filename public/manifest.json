{
  "manifest_version": 3,
  "name": "Universal Video Speed",
  "version": "0.1.0",
  "description": "One keyboard shortcut. Any video.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Universal Video Speed settings"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
